# Dependencies
node_modules
npm-debug.log*

# Next.js build output
.next
out

# Environment files
.env
.env.local
.env.*.local

# IDE
.vscode
.idea
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Docker
Dockerfile
docker-compose.yml
.dockerignore

# Git
.git
.gitignore

# Tests
e2e
playwright.config.ts
playwright-report

# Misc
README.md
LICENSE
*.md

# Deploy artefacts — never part of the build context.
# deploy.sh writes the saved image tarball here, so without this the NEXT build ships the PREVIOUS
# image into its own context: 155 MB of pure waste on every rebuild, growing each time.
*.tgz
*.tar
# Never let a private key reach an image layer.
*.pem
*.key
