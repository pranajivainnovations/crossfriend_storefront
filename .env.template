# Your Medusa backend URL — this is the ONLY place to configure it.
# Used at runtime by the server (SSR). No build-time dependency.
MEDUSA_BACKEND_URL=http://localhost:9001

# Your store URL, should be updated to where you are hosting your storefront.
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# Your preferred default region. When middleware cannot determine the user region from the "x-vercel-country" header, the default region will be used. ISO-2 lowercase format. 
NEXT_PUBLIC_DEFAULT_REGION=us

# Your Stripe public key. See – https://docs.medusajs.com/add-plugins/stripe
NEXT_PUBLIC_STRIPE_KEY=

# Your PayPal Client ID. See – https://docs.medusajs.com/add-plugins/paypal
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Your MeiliSearch / Algolia keys. See – https://docs.medusajs.com/add-plugins/meilisearch or https://docs.medusajs.com/add-plugins/algolia
NEXT_PUBLIC_SEARCH_APP_ID=
NEXT_PUBLIC_SEARCH_ENDPOINT=http://127.0.0.1:7700
NEXT_PUBLIC_SEARCH_API_KEY=
NEXT_PUBLIC_INDEX_NAME=products

# Your Next.js revalidation secret. See – https://nextjs.org/docs/app/building-your-application/data-fetching/fetching-caching-and-revalidating#on-demand-revalidation
REVALIDATE_SECRET=supersecret

# AI Cake Studio — when "true", the studio uses local mock designs instead of
# calling the real generation backend (which costs money per call, ~₹2-3 per
# generation). Set to "true" for local dev. Must be unset or "false" in any
# environment where real AI generation should happen.
NEXT_PUBLIC_USE_MOCK_AI_STUDIO=true

# Google Analytics 4 measurement ID (G-XXXXXXXXXX).
# Leave unset in development and preview builds: with no ID the tag, the page-view tracker and the
# consent banner all render nothing, which is what keeps test orders out of production reporting.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ── OTP sign-in ───────────────────────────────────────────────────────────────
# Salt for the derived Medusa password behind mobile sign-in. Minimum 32 chars.
# Sign-in fails closed without it — there is deliberately no default, because the
# previous hardcoded fallback shipped to production and made every customer
# password computable from source. Generate with: openssl rand -hex 32
OTP_PASSWORD_SALT=

# ── Browser notifications ──────────────────────────────────────────────────────────────────────
# The public half of the VAPID pair, shared with OPS. OPS holds the private key and does the
# sending; this is only what a browser needs in order to subscribe. Unset means the opt-in card
# never appears, and nothing else on the site changes.
VAPID_PUBLIC_KEY=
